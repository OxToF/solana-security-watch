{
  "name": "solana-security-watch",
  "version": "1.1.0",
  "description": "Continuous security monitoring for Solana/Anchor programs — a Claude Code skill, /security-watch command, and security-auditor agent.",
  "license": "MIT",
  "author": "OxToF",
  "type": "module",
  "bin": {
    "solana-security-watch": "bin/cli.mjs"
  },
  "files": [
    "bin",
    "skills",
    "commands",
    "agents",
    "examples",
    "poc/*/programs/**",
    "poc/*/tests/**",
    "poc/*/target/deploy/*.so",
    "poc/*/target/idl/**",
    "poc/*/Anchor.toml",
    "poc/*/Cargo.toml",
    "poc/*/package.json",
    "poc/*/tsconfig.json",
    "poc/*/.mocharc.cjs",
    "poc/*/.yarnrc",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/OxToF/solana-security-watch.git"
  },
  "keywords": [
    "solana",
    "anchor",
    "security",
    "audit",
    "claude-code",
    "claude-code-skill",
    "rustsec",
    "osv",
    "supply-chain",
    "poc"
  ],
  "scripts": {
    "collect": "node bin/cli.mjs collect --out watch-reports",
    "test:pocs": "bash poc/run-all.sh",
    "test": "bash poc/run-all.sh"
  }
}
